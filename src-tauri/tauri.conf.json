{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monke",
  "version": "0.1.25",
  "identifier": "io.github.yigitfire.sesapp",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Monke",
        "width": 900,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost wss: https://api.klipy.com",
        "img-src": "'self' data: blob: https://yigitfire.github.io https://static.klipy.com https://static1.klipy.com https://static2.klipy.com",
        "media-src": "'self' blob: mediastream:",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/eski-ses-kaldir.nsh",
        "languages": [
          "Turkish"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGNUJENzBBM0E3RkFERUMKUldUc3JYODZDdGRiZjMwYlo1SjYzU0ZiVmhDdXZsMTk5dU9mZjlUd3FabGpWbEcxN0svdUZ2cWwK",
      "endpoints": [
        "https://github.com/yigitfire/sesapp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
